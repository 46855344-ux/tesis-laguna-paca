# Copiar a .env y cambiar TODOS los valores marcados.
#
#   Copy-Item .env.example .env        (PowerShell)
#   cp .env.example .env               (bash)
#
# .env está en .gitignore: no se versiona ningún secreto.

# --- PostgreSQL ---
DB_NAME=laguna_paca
DB_USER=laguna
DB_PASSWORD=cambia-la-clave-de-la-base
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# Cadena larga y aleatoria (mínimo 32 bytes). Ejemplo para generar una:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-cadena-por-una-aleatoria-de-al-menos-32-bytes
APP_USER=admin
APP_PASSWORD=cambia-la-clave-del-panel

# --- Servicio de IA (perfil "integrated") ---
# Token compartido entre Spring Boot y FastAPI. Si queda vacío, /predict no
# exige cabecera; en una red compartida debe definirse.
IA_INTERNAL_TOKEN=

# --- MQTT (perfil "mqtt") ---
MQTT_ENABLED=false
MQTT_TOPIC=laguna-paca/telemetry
MQTT_PORT=1883

# --- Google Maps (opcional) ---
# Clave de navegador restringida por referente; dejar vacío para usar el
# contorno SVG sin conexión.
GOOGLE_MAPS_API_KEY=
